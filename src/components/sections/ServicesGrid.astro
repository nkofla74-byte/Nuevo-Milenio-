---
/**
 * Service catalog with category filter. Filtering is plain JS (works with reduced motion);
 * GSAP Flip is loaded only as an enhancement to animate the re-layout.
 */
import { getCollection } from 'astro:content';
import { CATEGORIES, type CategoryKey } from '../../config/categories';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  index?: string;
  heading?: boolean;
}
const { index = '03', heading = true } = Astro.props;
const services = (await getCollection('servicios')).sort((a, b) => a.data.order - b.data.order);
const used = [...new Set(services.map((s) => s.data.category))] as CategoryKey[];
---

<section id="servicios" data-section-index={index} data-section-label="Servicios" class="services-grid bg-bone py-24">
  <div class="container-x">
    {heading && (
      <SectionHeading index={index} label="Servicios" title="Todo lo que su espacio necesita.">
        <p class="mt-6 max-w-2xl text-lg text-concrete-700">
          Ocho especialidades coordinadas bajo un mismo cronograma. Filtre por categoría o explore cada servicio.
        </p>
      </SectionHeading>
    )}

    <div class="chip-row mt-10" role="group" aria-label="Filtrar servicios por categoría">
      <button type="button" data-filter="all" aria-pressed="true" class="filter-btn">
        Todos
      </button>
      {used.map((c) => (
        <button type="button" data-filter={c} aria-pressed="false" class="filter-btn">
          {CATEGORIES[c]}
        </button>
      ))}
    </div>

    <!-- Phones: compact rows (icon · title · 2-line summary · arrow). From sm up: cards. -->
    <ul class="mt-8 grid gap-px bg-carbon/10 sm:mt-10 sm:grid-cols-2 lg:grid-cols-4">
      {services.map((s) => (
        <li data-service-card data-category={s.data.category} class="group relative bg-bone">
          <a
            href={`/servicios/${s.id}/`}
            class="flex h-full items-start gap-4 px-1 py-5 transition-colors duration-300 hover:bg-carbon hover:text-bone active:bg-concrete-100 sm:flex-col sm:gap-0 sm:p-6"
          >
            <span class="flex shrink-0 items-start justify-between sm:w-full">
              <Icon name={s.data.icon} size={36} class="text-accent-strong group-hover:text-accent" />
              <span class="hidden font-mono text-[11px] uppercase tracking-widest text-concrete-700 group-hover:text-concrete-300 sm:inline">
                {CATEGORIES[s.data.category]}
              </span>
            </span>
            <span class="flex min-w-0 flex-1 flex-col sm:w-full">
              <span class="font-mono text-[11px] uppercase tracking-widest text-concrete-700 group-hover:text-concrete-300 sm:hidden">
                {CATEGORIES[s.data.category]}
              </span>
              <span class="mt-1 font-display text-2xl uppercase leading-none sm:mt-6 sm:text-3xl md:mt-10">{s.data.title}</span>
              <span class="mt-2 line-clamp-2 text-sm text-concrete-700 group-hover:text-concrete-300 sm:mt-3 sm:line-clamp-none">{s.data.summary}</span>
              {s.data.needsConfirmation && <span class="pending mt-3 self-start">[[PENDIENTE: confirmar servicio]]</span>}
            </span>
            <Icon name="arrow-right" size={20} class="mt-6 shrink-0 text-accent-strong sm:hidden" />
            <span class="mt-auto hidden items-center gap-2 pt-6 text-sm font-semibold sm:flex">
              Ver servicio <Icon name="arrow-right" size={16} class="transition-transform group-hover:translate-x-1" />
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .filter-btn {
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border: 1px solid rgb(22 21 26 / 0.25);
    font-size: 0.9rem;
    transition:
      background-color var(--duration-fast),
      color var(--duration-fast);
  }
  .filter-btn:hover {
    border-color: var(--color-carbon);
  }
  .filter-btn[aria-pressed='true'] {
    background: var(--color-carbon);
    border-color: var(--color-carbon);
    color: var(--color-bone);
  }
</style>

<script>
  import { prefersReducedMotion } from '../../lib/motion';

  document.querySelectorAll<HTMLElement>('.services-grid').forEach((root) => {
    const cards = [...root.querySelectorAll<HTMLElement>('[data-service-card]')];
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const animate = !prefersReducedMotion();

    buttons.forEach((btn) =>
      btn.addEventListener('click', async () => {
        const filter = btn.dataset.filter!;
        const apply = () => {
          buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
          cards.forEach((c) => (c.hidden = filter !== 'all' && c.dataset.category !== filter));
        };
        if (!animate) return apply();
        const [{ gsap }, { Flip }] = await Promise.all([import('gsap'), import('gsap/Flip')]);
        gsap.registerPlugin(Flip);
        const state = Flip.getState(cards);
        apply();
        Flip.from(state, {
          duration: 0.6,
          ease: 'expo.out',
          absolute: true,
          onEnter: (els) => gsap.fromTo(els, { autoAlpha: 0, scale: 0.94 }, { autoAlpha: 1, scale: 1, duration: 0.5 }),
          onLeave: (els) => gsap.to(els, { autoAlpha: 0, scale: 0.94, duration: 0.3 }),
        });
      }),
    );
  });
</script>
