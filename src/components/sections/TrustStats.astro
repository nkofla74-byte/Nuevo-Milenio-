---
import { site, isPending } from '../../config/site';
---

<section id="cifras" data-section-index="01" data-section-label="Cifras" class="border-b border-carbon/10 bg-bone" aria-label="Cifras de la empresa">
  <div class="container-x grid grid-cols-2 gap-px bg-carbon/10 md:grid-cols-4">
    {site.stats.map((s) => (
      <div class="bg-bone px-2 py-10 md:px-6 md:py-14">
        <p class="font-display text-[clamp(2.75rem,6vw,5.5rem)] leading-none">
          {isPending(s.value) ? (
            <span class="pending text-base">[[PENDIENTE: cifra real]]</span>
          ) : (
            <><span data-count={s.value}>{new Intl.NumberFormat('es-CO').format(s.value)}</span><span class="text-accent">{s.suffix}</span></>
          )}
        </p>
        <p class="mt-3 font-mono text-xs uppercase tracking-widest text-concrete-700">{s.label}</p>
      </div>
    ))}
  </div>
</section>
