---
import { breadcrumbJsonLd } from '../../lib/seo';

export interface Crumb {
  href: string;
  label: string;
}
interface Props {
  items: Crumb[];
  tone?: 'dark' | 'light';
}
const { items, tone = 'dark' } = Astro.props;
const all = [{ href: '/', label: 'Inicio' }, ...items];
const jsonLd = breadcrumbJsonLd(all, Astro.site ?? new URL('https://www.ejemplo.com.co'));
---

<nav aria-label="Migas de pan" class:list={['font-mono text-xs uppercase tracking-widest', tone === 'light' ? 'text-concrete-300' : 'text-concrete-700']}>
  <ol class="flex flex-wrap items-center gap-2">
    {all.map((c, i) => (
      <li class="flex items-center gap-2">
        {i > 0 && <span aria-hidden="true">/</span>}
        {i === all.length - 1 ? (
          <span aria-current="page" class="text-accent">
            {c.label}
          </span>
        ) : (
          <a href={c.href} class="hover:text-accent">
            {c.label}
          </a>
        )}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
