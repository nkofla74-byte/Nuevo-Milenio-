---
import Breadcrumbs, { type Crumb } from './Breadcrumbs.astro';

interface Props {
  crumbs: Crumb[];
  eyebrow: string;
  title: string;
  lead?: string;
}
const { crumbs, eyebrow, title, lead } = Astro.props;
---

<header class="blueprint-grid-dark relative bg-carbon pb-16 pt-[calc(var(--header-h)+3rem)] text-bone md:pb-24">
  <div class="container-x">
    <Breadcrumbs items={crumbs} tone="light" />
    <p class="mt-10 flex items-center gap-3 font-mono text-xs uppercase tracking-[0.2em] text-concrete-300">
      <span aria-hidden="true" class="h-px w-10 bg-accent" data-draw-line></span>
      {eyebrow}
    </p>
    <h1 data-split class="mt-4 max-w-5xl text-[clamp(2.75rem,7vw,6.5rem)] leading-[0.9]">
      {title}
    </h1>
    {lead && <p class="mt-6 max-w-2xl text-lg text-concrete-300 md:text-xl">{lead}</p>}
    <slot />
  </div>
</header>
