---
import Icon, { type IconName } from './Icon.astro';

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'light';
  size?: 'md' | 'lg';
  icon?: IconName;
  type?: 'button' | 'submit';
  magnetic?: boolean;
  class?: string;
  [key: string]: unknown;
}

const { href, variant = 'primary', size = 'md', icon = 'arrow-right', type = 'button', magnetic = false, class: className, ...rest } = Astro.props;

const base =
  'group relative inline-flex items-center justify-center gap-3 font-display uppercase tracking-wide transition-colors duration-200 select-none min-h-12';
const variants = {
  primary: 'bg-accent text-accent-ink hover:bg-carbon hover:text-bone',
  secondary: 'border border-current text-current hover:bg-carbon hover:text-bone hover:border-carbon',
  ghost: 'text-current underline-offset-8 hover:underline decoration-accent decoration-2',
  light: 'border border-bone/40 text-bone hover:bg-bone hover:text-carbon',
};
const sizes = { md: 'px-6 py-3 text-lg', lg: 'px-8 py-4 text-xl' };
const classes = [base, variants[variant], variant !== 'ghost' && sizes[size], className];
const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  type={href ? undefined : type}
  class:list={classes}
  data-magnetic={magnetic ? '' : undefined}
  {...rest}
>
  <span><slot /></span>
  <Icon name={icon} size={20} class="transition-transform duration-300 group-hover:translate-x-1" />
</Tag>
