---
/**
 * Module self-assessment. Answers are kept in localStorage (this browser only) and
 * copied as text so the student can paste them in the chat for evaluation.
 * Deliberately contains no answer key.
 */
interface Props {
  moduleId: string;
  title: string;
  questions: { q: string; hint?: string }[];
}
const { moduleId, title, questions } = Astro.props;
---

<section class="quiz mt-16 border-2 border-carbon p-6 md:p-8" data-module={moduleId} data-title={title}>
  <p class="font-mono text-xs tracking-widest text-accent-strong">EVALUACIÓN DEL MÓDULO</p>
  <h2 class="mt-2 text-4xl">Comprueba lo que aprendiste</h2>
  <p class="mt-3 max-w-3xl text-concrete-700">
    Responde con tus palabras; no hace falta que sea perfecto. Después pulsa <strong>«Copiar mis respuestas»</strong> y pégalas en el chat: las evalúo, corrijo y te explico lo que falte.
  </p>
  <ol class="mt-6 space-y-6">
    {questions.map((item, i) => (
      <li>
        <label for={`${moduleId}-q${i}`} class="block font-semibold">{i + 1}. {item.q}</label>
        {item.hint && <p class="mt-1 text-sm text-concrete-700">Pista: {item.hint}</p>}
        <textarea id={`${moduleId}-q${i}`} data-q={item.q} rows="3" class="mt-2 w-full border border-concrete-500 bg-white p-3 focus:border-carbon"></textarea>
      </li>
    ))}
  </ol>
  <div class="mt-6 flex flex-wrap items-center gap-4">
    <button type="button" data-copy class="bg-carbon px-6 py-3 font-display text-xl uppercase text-bone hover:bg-accent hover:text-carbon">Copiar mis respuestas</button>
    <span data-status class="text-sm text-concrete-700" aria-live="polite"></span>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.quiz').forEach((quiz) => {
    const key = `academia-quiz-${quiz.dataset.module}`;
    const fields = [...quiz.querySelectorAll<HTMLTextAreaElement>('textarea')];
    const status = quiz.querySelector<HTMLElement>('[data-status]')!;
    try {
      const saved = JSON.parse(localStorage.getItem(key) ?? '[]') as string[];
      fields.forEach((f, i) => (f.value = saved[i] ?? ''));
    } catch {
      /* storage unavailable: start empty */
    }
    quiz.addEventListener('input', () => {
      try {
        localStorage.setItem(key, JSON.stringify(fields.map((f) => f.value)));
        status.textContent = 'Guardado en este navegador.';
      } catch {
        status.textContent = 'No se pudo guardar (almacenamiento bloqueado).';
      }
    });
    quiz.querySelector('[data-copy]')?.addEventListener('click', async () => {
      const text = [
        `Evaluación — ${quiz.dataset.title}`,
        ...fields.map((f, i) => `\n${i + 1}. ${f.dataset.q}\nMi respuesta: ${f.value.trim() || '(sin responder)'}`),
      ].join('\n');
      try {
        await navigator.clipboard.writeText(text);
        status.textContent = 'Copiado. Pégalo en el chat.';
      } catch {
        status.textContent = 'No se pudo copiar automáticamente; selecciona y copia el texto manualmente.';
      }
    });
  });
</script>
