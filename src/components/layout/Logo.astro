---
import { site } from '../../config/site';
// [[PENDIENTE: logo real en SVG]] — temporary wordmark built from the brand name.
---

<span class="flex items-center gap-2.5">
  <svg viewBox="0 0 32 32" width="32" height="32" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
    <path d="M3 29V13l13-9 13 9v16" />
    <path d="M3 29h26" />
    <path d="M10 29V18h12v11" class="text-accent" stroke="var(--color-accent)" />
  </svg>
  <span class="font-display text-2xl leading-none uppercase tracking-wide">
    {site.brandName}
    {site.brandPending && (
      <sup class="ml-0.5 font-mono text-[9px] text-accent" title="Nombre comercial pendiente">
        *
      </sup>
    )}
  </span>
</span>
