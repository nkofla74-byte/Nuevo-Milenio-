---
import InternalShell from '../../components/internal/InternalShell.astro';
import progress from '../../data/progress.json';

// Dev-only route: no paths in production builds.
export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { index: undefined } }] : [];
}

const labels: Record<string, string> = {
  done: 'Terminada',
  doing: 'En curso',
  todo: 'Pendiente',
  blocked: 'Bloqueada',
};
const done = progress.phases.filter((p) => p.status === 'done').length;
const pct = Math.round((done / progress.phases.length) * 100);
---

<InternalShell title="Progreso del desarrollo" active="progreso">
  <main class="blueprint-grid-dark min-h-screen bg-carbon text-bone">
    <div class="container-x py-12">
      <p class="font-mono text-xs tracking-widest text-concrete-300">PLANO DE AVANCE · {progress.updatedAt}</p>
      <h1 class="mt-3 text-6xl md:text-8xl">Progreso del sitio</h1>
      <p class="mt-4 text-lg text-concrete-300">
        Actual: <strong class="text-accent">{progress.current}</strong>
      </p>

      <div
        class="mt-8 h-3 w-full overflow-hidden rounded-sm bg-carbon-2"
        role="progressbar"
        aria-valuenow={pct}
        aria-valuemin="0"
        aria-valuemax="100"
        aria-label="Fases terminadas"
      >
        <div class="h-full bg-accent transition-[width] duration-700" style={`width:${pct}%`}></div>
      </div>
      <p class="mt-2 font-mono text-sm text-concrete-300">
        {done} de {progress.phases.length} fases · {pct}%
      </p>

      <ol class="mt-10 grid gap-4 md:grid-cols-2">
        {progress.phases.map((phase) => (
          <li
            class:list={[
              'border p-5',
              phase.status === 'done' && 'border-success/60',
              phase.status === 'doing' && 'border-accent bg-accent/5',
              phase.status === 'todo' && 'border-concrete-700',
              phase.status === 'blocked' && 'border-concrete-700 opacity-60',
            ]}
          >
            <div class="flex items-baseline justify-between gap-4">
              <h2 class="text-3xl">
                {String(phase.id).padStart(2, '0')} / {phase.name}
              </h2>
              <span class="shrink-0 font-mono text-xs uppercase tracking-widest">{labels[phase.status]}</span>
            </div>
            {phase.items.length > 0 && (
              <ul class="mt-3 space-y-1 text-sm text-concrete-300">
                {phase.items.map((item) => (
                  <li>— {item}</li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ol>

      <h2 class="mt-12 text-3xl">Bitácora</h2>
      <ol class="mt-4 space-y-2 font-mono text-sm text-concrete-300">
        {[...progress.log].reverse().map((entry) => (
          <li>› {entry}</li>
        ))}
      </ol>
    </div>
  </main>
</InternalShell>
