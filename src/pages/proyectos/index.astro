---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import Placeholder from '../../components/ui/Placeholder.astro';
import FinalCta from '../../components/sections/FinalCta.astro';

const projects = await getCollection('proyectos');
const sectors = await getCollection('sectores');
const usedSectors = sectors.filter((s) => projects.some((p) => p.data.sector === s.id));
---

<BaseLayout
  title="Proyectos"
  description="Casos de estudio de remodelación, adecuación y mantenimiento: el reto, la solución, el antes y el después de cada obra."
  headerTone="light"
>
  <PageHeader crumbs={[{ href: '/proyectos/', label: 'Proyectos' }]} eyebrow="Portafolio" title="Obras que cuentan su propia historia.">
    <p class="pending mt-6">[[PENDIENTE: proyectos reales — se muestran fichas de ejemplo]]</p>
  </PageHeader>

  <section class="projects-list container-x py-16">
    <div class="flex flex-wrap gap-2" role="group" aria-label="Filtrar por sector">
      <button type="button" data-filter="all" aria-pressed="true" class="filter-btn">Todos</button>
      {usedSectors.map((s) => <button type="button" data-filter={s.id} aria-pressed="false" class="filter-btn">{s.data.title}</button>)}
    </div>
    <ul class="mt-10 grid gap-10 md:grid-cols-2 lg:grid-cols-3">
      {projects.map((p) => (
        <li data-project data-sector={p.data.sector}>
          <a href={`/proyectos/${p.id}/`} class="group block">
            <div class="overflow-hidden" data-mask>
              <Placeholder seed={p.id} state="after" palette={p.data.palette} class="transition-transform duration-700 group-hover:scale-105" />
            </div>
            <p class="mt-4 font-mono text-xs uppercase tracking-widest text-concrete-700">{sectors.find((s) => s.id === p.data.sector)?.data.title} · {p.data.city}</p>
            <h2 class="mt-2 text-3xl group-hover:text-accent-strong">{p.data.title}</h2>
          </a>
        </li>
      ))}
    </ul>
  </section>
  <FinalCta />
</BaseLayout>

<style>
  .filter-btn { min-height: 2.75rem; padding: 0.5rem 1rem; border: 1px solid rgb(22 21 26 / 0.25); font-size: 0.9rem; }
  .filter-btn[aria-pressed='true'] { background: var(--color-carbon); color: var(--color-bone); border-color: var(--color-carbon); }
</style>

<script>
  const root = document.querySelector('.projects-list');
  if (root) {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const items = [...root.querySelectorAll<HTMLElement>('[data-project]')];
    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        items.forEach((it) => (it.hidden = btn.dataset.filter !== 'all' && it.dataset.sector !== btn.dataset.filter));
      }),
    );
  }
</script>
