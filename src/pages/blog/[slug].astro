---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import FinalCta from '../../components/sections/FinalCta.astro';
import { articleJsonLd } from '../../lib/seo';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
const services = (await getCollection('servicios')).filter((s) => d.relatedServices.includes(s.id));
const fmt = new Intl.DateTimeFormat('es-CO', { dateStyle: 'long' });
---

<BaseLayout
  title={d.seoTitle}
  description={d.description}
  headerTone="light"
  jsonLd={[articleJsonLd({ title: d.title, description: d.description, url: new URL(Astro.url.pathname, Astro.site), origin: Astro.site!, published: d.pubDate, modified: d.updatedDate })]}
>
  <div class="reading-progress fixed inset-x-0 top-0 z-[55] h-1 origin-left scale-x-0 bg-accent" aria-hidden="true"></div>
  <PageHeader crumbs={[{ href: '/blog/', label: 'Blog' }, { href: Astro.url.pathname, label: d.title }]} eyebrow={fmt.format(d.pubDate)} title={d.title} lead={d.description} />
  <div class="container-x grid gap-12 py-16 lg:grid-cols-12">
    <aside class="hidden lg:col-span-3 lg:block">
      <nav aria-label="Contenido del artículo" class="sticky top-28">
        <p class="font-mono text-xs uppercase tracking-widest text-concrete-700">En este artículo</p>
        <ol class="mt-3 space-y-2 border-l border-carbon/15 pl-4 text-sm">
          {headings.filter((h) => h.depth === 2).map((h) => <li><a href={`#${h.slug}`} class="hover:text-accent-strong">{h.text}</a></li>)}
        </ol>
      </nav>
    </aside>
    <article class="prose-site text-lg lg:col-span-7"><Content /></article>
  </div>
  {services.length > 0 && (
    <section class="container-x pb-16">
      <h2 class="text-3xl">Servicios relacionados</h2>
      <ul class="mt-4 flex flex-wrap gap-3">{services.map((s) => <li><a href={`/servicios/${s.id}/`} class="inline-block border border-carbon/20 px-4 py-2 hover:border-accent">{s.data.title}</a></li>)}</ul>
    </section>
  )}
  <FinalCta />
</BaseLayout>

<script>
  // Reading progress bar: transform only, one update per frame.
  const bar = document.querySelector<HTMLElement>('.reading-progress');
  if (bar) {
    let ticking = false;
    const update = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      bar.style.transform = `scaleX(${max > 0 ? window.scrollY / max : 0})`;
      ticking = false;
    };
    window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
  }
</script>
