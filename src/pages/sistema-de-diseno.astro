---
/** Internal design-system reference (noindex, excluded from sitemap). Replaces /_design: Astro ignores "_" routes. */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import BeforeAfter from '../components/ui/BeforeAfter.astro';
import Placeholder from '../components/ui/Placeholder.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import FaqList from '../components/ui/FaqList.astro';

const tokens = [
  'carbon',
  'carbon-2',
  'concrete-900',
  'concrete-700',
  'concrete-500',
  'concrete-300',
  'concrete-100',
  'bone',
  'accent',
  'accent-strong',
  'success',
  'danger',
];
const palettes = [
  { name: 'A · Concreto + naranja seguridad (activa)', colors: ['#16151a', '#5e5953', '#c4beb5', '#f5f1ea', '#f2611d'] },
  { name: 'B · Grafito + amarillo obra', colors: ['#121417', '#4a4f55', '#bfc3c7', '#f4f4f1', '#f5b700'] },
  { name: 'C · Arena cálida + terracota', colors: ['#1d1a17', '#6b5d50', '#d6c8b8', '#faf6f0', '#c4532d'] },
];
const icons = [
  'hammer',
  'truck',
  'bricks',
  'layers',
  'storefront',
  'utensils',
  'building',
  'buildings',
  'roller',
  'drop',
  'tiles',
  'saw',
  'panel',
  'ceiling',
  'grid',
  'bolt',
  'pipe',
  'weld',
  'roof',
  'facade',
  'wrench',
  'mall',
  'cart',
  'home',
  'factory',
  'helmet',
  'shield',
  'ruler',
  'file',
  'download',
  'phone',
  'mail',
  'pin',
  'clock',
  'chat',
  'check',
  'arrow-right',
  'arrow-down',
  'menu',
  'close',
];
---

<BaseLayout title="Sistema de diseño" description="Referencia interna de componentes y tokens." noindex headerTone="light">
  <PageHeader
    crumbs={[{ href: '/sistema-de-diseno/', label: 'Sistema de diseño' }]}
    eyebrow="Interno · noindex"
    title="Sistema de diseño"
    lead="Tokens y componentes del sitio. Documentación completa en /docs/design-system.md."
  />

  <div class="container-x space-y-24 py-20">
    <section>
      <h2 class="text-4xl">Colores (tokens activos)</h2>
      <ul class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-4 lg:grid-cols-6">
        {tokens.map((t) => (
          <li>
            <div class="h-20 border border-carbon/10" style={`background:var(--color-${t})`}></div>
            <p class="mt-2 font-mono text-xs">--color-{t}</p>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2 class="text-4xl">Variantes de paleta para escoger</h2>
      <p class="mt-2 text-concrete-700">
        Contraste del acento sobre fondo oscuro verificado con WCAG AA para textos grandes. <span class="pending">[[PENDIENTE: elección del cliente]]</span>
      </p>
      <ul class="mt-6 grid gap-6 md:grid-cols-3">
        {palettes.map((p) => (
          <li class="border border-carbon/15 p-4">
            <div class="flex h-24">
              {p.colors.map((c) => (
                <span class="flex-1" style={`background:${c}`}></span>
              ))}
            </div>
            <p class="mt-3 font-semibold">{p.name}</p>
            <p class="font-mono text-xs text-concrete-700">{p.colors.join(' · ')}</p>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2 class="text-4xl">Tipografía</h2>
      <p class="mt-6 font-display text-8xl uppercase leading-none">Barlow Condensed</p>
      <p class="mt-2 font-mono text-xs">--font-display · 500 / 600 / 700 · titulares</p>
      <p class="mt-8 text-2xl">Inter: texto legible para párrafos, formularios y navegación. Áéíóú ñ ¿? ¡!</p>
      <p class="mt-2 font-mono text-xs">--font-body · 400–700 variable</p>
    </section>

    <section>
      <h2 class="text-4xl">Botones</h2>
      <div class="mt-6 flex flex-wrap gap-4">
        <Button href="#">Primario</Button>
        <Button href="#" variant="secondary">
          Secundario
        </Button>
        <Button href="#" variant="ghost">
          Ghost
        </Button>
        <Button href="#" size="lg" magnetic>
          Grande magnético
        </Button>
      </div>
      <div class="mt-6 flex flex-wrap gap-4 bg-carbon p-6">
        <Button href="#" variant="light">
          Sobre oscuro
        </Button>
      </div>
    </section>

    <section>
      <h2 class="text-4xl">Íconos ({icons.length})</h2>
      <ul class="mt-6 grid grid-cols-4 gap-4 sm:grid-cols-8 lg:grid-cols-10">
        {icons.map((i) => (
          <li class="flex flex-col items-center gap-2 border border-carbon/10 p-3">
            <Icon name={i} size={28} />
            <span class="font-mono text-[10px]">{i}</span>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <SectionHeading index="00" label="Encabezado de sección" title="Título de sección" />
    </section>

    <section>
      <h2 class="text-4xl">Comparador antes/después</h2>
      <BeforeAfter label="Ejemplo de sistema de diseño" class="mt-6 max-w-3xl">
        <Placeholder slot="before" seed="design" state="before" label="Ejemplo antes" ratio="16 / 9" />
        <Placeholder slot="after" seed="design" state="after" label="Ejemplo después" ratio="16 / 9" class="h-full" />
      </BeforeAfter>
    </section>

    <section>
      <h2 class="text-4xl">Preguntas frecuentes</h2>
      <FaqList faqs={[{ q: '¿Pregunta de ejemplo?', a: 'Respuesta de ejemplo con un [[PENDIENTE: marcador]].' }]} class="mt-6 max-w-3xl" />
    </section>

    <section>
      <h2 class="text-4xl">Marcador de contenido pendiente</h2>
      <p class="mt-4">
        <span class="pending">[[PENDIENTE: dato real]]</span> — se usa en lugar de inventar información.
      </p>
    </section>
  </div>
</BaseLayout>
