---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import Icon from '../../components/ui/Icon.astro';
import Button from '../../components/ui/Button.astro';
import FaqList from '../../components/ui/FaqList.astro';
import FinalCta from '../../components/sections/FinalCta.astro';
import { CATEGORIES } from '../../content.config';
import { serviceJsonLd, faqJsonLd } from '../../lib/seo';
import { markPending } from '../../lib/pending';

export async function getStaticPaths() {
  const services = await getCollection('servicios');
  return services.map((service) => ({ params: { slug: service.id }, props: { service } }));
}

const { service } = Astro.props;
const { Content } = await render(service);
const d = service.data;
const origin = Astro.site!;

const sectors = (await getCollection('sectores')).filter((s) => d.sectors.includes(s.id));
const related = (await getCollection('servicios'))
  .filter((s) => s.id !== service.id && s.data.category === d.category)
  .slice(0, 3);
const projects = (await getCollection('proyectos')).filter((p) => p.data.services.includes(service.id));
---

<BaseLayout
  title={d.seoTitle}
  description={d.description}
  whatsappMessage={d.whatsappMessage}
  headerTone="light"
  jsonLd={[
    serviceJsonLd({ name: d.title, description: d.description, url: new URL(Astro.url.pathname, origin), origin, category: CATEGORIES[d.category] }),
    faqJsonLd(d.faqs),
  ]}
>
  <PageHeader
    crumbs={[{ href: '/servicios/', label: 'Servicios' }, { href: Astro.url.pathname, label: d.title }]}
    eyebrow={CATEGORIES[d.category]}
    title={d.title}
    lead={d.summary}
  >
    {d.needsConfirmation && <p class="pending mt-4">[[PENDIENTE: confirmar que la empresa ofrece este servicio]]</p>}
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href={`/cotizar/?servicio=${service.id}`} size="lg" magnetic>Cotizar este servicio</Button>
    </div>
  </PageHeader>

  <div class="container-x grid gap-16 py-20 lg:grid-cols-12">
    <article class="prose-site lg:col-span-7">
      <Content />
    </article>

    <aside class="space-y-10 lg:col-span-5">
      <section class="border border-carbon/15 p-6" aria-labelledby="incluye">
        <h2 id="incluye" class="text-3xl">Qué incluye</h2>
        <ul class="mt-5 space-y-3">
          {d.includes.map((item) => (
            <li class="flex gap-3"><Icon name="check" size={20} class="mt-0.5 shrink-0 text-accent-strong" /><span set:html={markPending(item)} /></li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="proceso-servicio">
        <h2 id="proceso-servicio" class="text-3xl">Cómo lo hacemos</h2>
        <ol class="mt-5 space-y-3">
          {d.process.map((step, i) => (
            <li class="flex gap-4"><span class="font-mono text-sm text-accent-strong">{String(i + 1).padStart(2, '0')}</span><span set:html={markPending(step)} /></li>
          ))}
        </ol>
      </section>

      {d.materials.length > 0 && (
        <section aria-labelledby="materiales">
          <h2 id="materiales" class="text-3xl">Materiales y equipos</h2>
          <ul class="mt-4 flex flex-wrap gap-2">
            {d.materials.map((m) => <li class="border border-carbon/20 px-3 py-1 text-sm" set:html={markPending(m)} />)}
          </ul>
        </section>
      )}

      <section class="bg-concrete-100 p-6" aria-labelledby="tiempos">
        <h2 id="tiempos" class="flex items-center gap-2 text-3xl"><Icon name="clock" />Tiempos típicos</h2>
        <p class="mt-3 text-concrete-700">{d.typicalTimes}</p>
      </section>
    </aside>
  </div>

  {d.faqs.length > 0 && (
    <section class="bg-concrete-100 py-20" aria-labelledby="faq">
      <div class="container-x max-w-4xl">
        <h2 id="faq" class="text-5xl">Preguntas frecuentes</h2>
        <FaqList faqs={d.faqs} class="mt-8" />
      </div>
    </section>
  )}

  <section class="container-x py-20" aria-labelledby="relacionados">
    <h2 id="relacionados" class="text-5xl">Relacionado</h2>
    <div class="mt-10 grid gap-10 md:grid-cols-2">
      {sectors.length > 0 && (
        <div>
          <h3 class="font-mono text-xs uppercase tracking-widest text-concrete-700">Sectores donde lo aplicamos</h3>
          <ul class="mt-4 flex flex-wrap gap-2">
            {sectors.map((s) => <li><a href={`/sectores/${s.id}/`} class="inline-flex items-center gap-2 border border-carbon/20 px-3 py-2 hover:border-accent"><Icon name={s.data.icon} size={18} />{s.data.title}</a></li>)}
          </ul>
        </div>
      )}
      {related.length > 0 && (
        <div>
          <h3 class="font-mono text-xs uppercase tracking-widest text-concrete-700">Otros servicios de {CATEGORIES[d.category].toLowerCase()}</h3>
          <ul class="mt-4 space-y-2">
            {related.map((s) => <li><a href={`/servicios/${s.id}/`} class="group inline-flex items-center gap-2 font-display text-2xl uppercase hover:text-accent-strong">{s.data.title}<Icon name="arrow-right" size={18} class="transition-transform group-hover:translate-x-1" /></a></li>)}
          </ul>
        </div>
      )}
      {projects.length > 0 && (
        <div>
          <h3 class="font-mono text-xs uppercase tracking-widest text-concrete-700">Proyectos con este servicio</h3>
          <ul class="mt-4 space-y-2">
            {projects.map((p) => <li><a href={`/proyectos/${p.id}/`} class="underline decoration-accent underline-offset-4">{p.data.title}</a></li>)}
          </ul>
        </div>
      )}
    </div>
  </section>

  <FinalCta title={`¿Necesita ${d.title.toLowerCase()}?`} whatsappMessage={d.whatsappMessage} />
</BaseLayout>
